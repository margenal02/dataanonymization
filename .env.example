# 生产环境请务必修改以下三个值
DJANGO_SECRET_KEY=please-change-this-secret-key
MAPPING_ENCRYPTION_KEY=please-change-this-mapping-key
MYSQL_ROOT_PASSWORD=please-change-this-db-password

MYSQL_DATABASE=data_anonymization
MYSQL_USER=anonymizer
MYSQL_PASSWORD=please-change-this-user-password
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_SIZE_MB=50
DATA_RETENTION_DAYS=30

# 默认使用官方源；中国大陆自动安装脚本会改为国内镜像。
MYSQL_IMAGE=mysql:8.4
PYTHON_IMAGE=python:3.13-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=
