# 生产环境请务必修改以下三个值
DJANGO_SECRET_KEY=please-change-this-secret-key
MAPPING_ENCRYPTION_KEY=please-change-this-mapping-key
MYSQL_ROOT_PASSWORD=please-change-this-db-password

MYSQL_DATABASE=data_anonymization
MYSQL_USER=anonymizer
MYSQL_PASSWORD=please-change-this-user-password
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_SIZE_MB=200
DATA_RETENTION_DAYS=30

# 默认使用官方源；中国大陆自动安装脚本会改为国内镜像。
MYSQL_IMAGE=mysql:8.4
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=

# 本地 UIE-micro；模型在镜像构建时预取，运行模式由 Web 页面选择。
UIE_ENABLED=1
UIE_MODEL=uie-micro
UIE_POSITION_PROB=0.45
UIE_PERSON_PROB=0.70
UIE_ORGANIZATION_PROB=0.55
UIE_ADDRESS_PROB=0.60
UIE_LOCATION_PROB=0.60
UIE_PRODUCT_PROB=0.60
UIE_BATCH_SIZE=2
UIE_MAX_SEQ_LEN=512
UIE_MAX_TOTAL_CHARS=500000
UIE_START_TIMEOUT_SECONDS=180
UIE_REQUEST_TIMEOUT_SECONDS=600

# 扫描 PDF 自动使用容器内 Tesseract 简体中文+英文 OCR。
PDF_OCR_ENABLED=1
PDF_OCR_LANGUAGES=chi_sim+eng
PDF_OCR_DPI=180
PDF_OCR_MAX_IMAGE_DIMENSION=3508
PDF_OCR_MIN_TEXT_CHARS=12
PDF_OCR_MAX_PAGES=300
PDF_OCR_MAX_TOTAL_CHARS=500000
PDF_OCR_PAGE_TIMEOUT_SECONDS=180
